# Copy to backend/.env and edit. Every setting is optional; the defaults are in
# app/config.py. Restart the backend after a change (it does not hot-reload).

# Database. SQLite needs no server; a MySQL DSN works too.
MYSQL_DSN=sqlite:///./spine.db

# TotalSpineSeg CLI, installed in its own venv (see README). Only needed to
# grade new studies; viewing graded ones works without it.
TOTALSPINESEG_BIN=/absolute/path/to/totalspineseg-venv/bin/totalspineseg
# SEG_DEVICE: cpu | cuda (not mps). GRADING_DEVICE: auto = GPU if torch sees
# one, else CPU.
SEG_DEVICE=cpu
GRADING_DEVICE=auto

# Passphrase for /admin. Empty = no lock, fine on your own machine. Set it on
# any machine other people can reach.
ADMIN_PASSWORD=

# Trial mode (see README "Trial mode"). Leave as is for normal use.
VIEW_ONLY=false
SURVEY_FORM_URL=

# Re-training from /admin: path to rsna_preprocessed from the spinet-v2 repo
# (~8.2 GB). Empty = re-training is shown as blocked, with the reason.
RETRAIN_REPLAY_DIR=

# Built frontend the backend serves on its own port, so other people open one
# URL. Empty = ../frontend/dist if it has been built, else API only.
FRONTEND_DIST=
